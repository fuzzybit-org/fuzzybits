{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fuzzybit-org/fuzzybits/blob/develop/benchmarks/schemas/results.v1.json",
  "title": "fuzzybits benchmark harness results",
  "description": "Versioned JSON written by `python -m benchmarks run|ab` (#121).",
  "type": "object",
  "required": ["schema_version", "kind", "dataset", "created_utc", "context", "models"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "enum": ["run", "ab"] },
    "dataset": { "type": "string" },
    "created_utc": { "type": "string" },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "pass (low power)",
        "infeasible",
        "known_failure",
        "timeout",
        "warn",
        "block",
        "error",
        "inconclusive"
      ]
    },
    "context": { "type": "object" },
    "models": { "type": "array" },
    "private": {
      "type": "array",
      "description": "One row per private v2 entry and mode, and nothing else (#184): a private model's names, paths and values never reach a results file.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "verdict"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "enum": ["compile", "perf", "accuracy-boolean", "hull"] },
          "verdict": { "type": "string", "enum": ["pass", "fail", "skipped"] },
          "reason": {
            "type": "string",
            "enum": [
              "no-match",
              "ambiguous",
              "no-reference",
              "hull",
              "not-declared",
              "error"
            ]
          }
        }
      }
    },
    "summary": { "type": "object" }
  }
}
