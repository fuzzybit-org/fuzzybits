<?xml version="1.0"?>
<!-- TOP = A & not G1, G1 = B & C. P(G1) = 0.2 * 0.3 = 0.06, P(TOP) = 0.5 * 0.94 = 0.47. A query on G1 is 0.06,
     however the negation on TOP's edge is normalised. -->
<opsa-mef>
  <define-fault-tree name="FT">
    <define-gate name="TOP"><and><basic-event name="A"/><not><gate name="G1"/></not></and></define-gate>
    <define-gate name="G1"><and><basic-event name="B"/><basic-event name="C"/></and></define-gate>
    <define-basic-event name="A"><float value="0.5"/></define-basic-event>
    <define-basic-event name="B"><float value="0.2"/></define-basic-event>
    <define-basic-event name="C"><float value="0.3"/></define-basic-event>
  </define-fault-tree>
</opsa-mef>
