<?xml version="1.0"?>
<!-- TOP = A & G, G = NOR(B, C). P(G) = 0.9 * 0.8 = 0.72; P(TOP) = 0.5 * 0.72 = 0.36. A query on G is 0.72. -->
<opsa-mef>
  <define-fault-tree name="FT">
    <define-gate name="TOP"><and><basic-event name="A"/><gate name="G"/></and></define-gate>
    <define-gate name="G"><nor><basic-event name="B"/><basic-event name="C"/></nor></define-gate>
    <define-basic-event name="A"><float value="0.5"/></define-basic-event>
    <define-basic-event name="B"><float value="0.1"/></define-basic-event>
    <define-basic-event name="C"><float value="0.2"/></define-basic-event>
  </define-fault-tree>
</opsa-mef>
