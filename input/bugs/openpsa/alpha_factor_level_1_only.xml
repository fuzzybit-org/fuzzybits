<?xml version="1.0"?>
<!-- Alpha-factor group {A, B}, Q = 0.1, alpha_1 = 1 (no common-cause failures). Non-staggered testing:
     Q_1 = 1 * alpha_1 / alpha_t * Q = 0.1 with alpha_t = 1, Q_2 = 0. P(A & B) = 0.1 * 0.1 = 0.01. -->
<opsa-mef>
  <define-fault-tree name="FT">
    <define-gate name="TOP"><and><basic-event name="A"/><basic-event name="B"/></and></define-gate>
    <define-CCF-group name="G" model="alpha-factor">
      <members><basic-event name="A"/><basic-event name="B"/></members>
      <distribution><float value="0.1"/></distribution>
      <factors><factor level="1"><float value="1"/></factor></factors>
    </define-CCF-group>
  </define-fault-tree>
</opsa-mef>
